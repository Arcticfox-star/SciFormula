# 运行期中间产物：每次跑都会重新生成，不需要提交
.agh_runs/

# Python
__pycache__/
*.pyc
.venv/
venv/

# 产物里只提交报告与明细表，其余忽略
results/*.tmp

# 对照实验用的隔离环境与离线 wheel（体积大、可重装，不进仓库）
.venv-baseline/
.baseline_wheels/

# 基线实验的导出数据（可由脚本重新生成）
results/baseline_input/
results/baseline_pred/

# 仿真台单次运行的时间序列（体积大，可由脚本随时重跑）
data/simulations/runs/
